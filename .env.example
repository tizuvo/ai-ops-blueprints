# ==============================================================================
# Tizuvo AI Ops Blueprints — Environment Variables
# Copy this file to .env (or configure in n8n environment / credential vault).
# Never commit real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Shared AI & Guardrail Controls
# ------------------------------------------------------------------------------
# OpenAI API key used by HTTP Request AI nodes (or store in n8n Header Auth credential)
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# Pinned model identifier to prevent unexpected drift or cost spikes
OPENAI_MODEL=gpt-4o-mini

# Minimum AI confidence score (0.0 - 1.0) required for automated routing
AI_CONFIDENCE_THRESHOLD=0.80

# Maximum character length accepted before LLM invocation (Blueprint 02 spend cap)
AI_MAX_INPUT_CHARS=12000

# ------------------------------------------------------------------------------
# Shared Slack Routing & Error Notifications
# ------------------------------------------------------------------------------
# Slack channel for workflow execution errors and guardrail rejections
SLACK_OPS_ALERT_CHANNEL=#ops-alerts

# Slack channel for low-confidence items and mandatory HITL approvals
SLACK_HUMAN_REVIEW_CHANNEL=#ops-human-review

# ------------------------------------------------------------------------------
# Blueprint 01: Lead Enrichment & CRM Sync
# ------------------------------------------------------------------------------
# Shared secret expected in the X-Webhook-Secret HTTP header
LEAD_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# CRM API base URL (HubSpot default; swap for Pipedrive or custom CRM)
CRM_API_BASE_URL=https://api.hubapi.com

# CRM Bearer token (HubSpot Private App token or Pipedrive API token)
CRM_API_TOKEN=REPLACE_WITH_CRM_API_TOKEN

# Slack channel for qualified high-confidence inbound lead alerts
SLACK_LEADS_CHANNEL=#inbound-leads

# ------------------------------------------------------------------------------
# Blueprint 02: Document Triage & Human-in-the-Loop (HITL)
# ------------------------------------------------------------------------------
# Shared secret expected in the X-Webhook-Secret HTTP header
DOC_TRIAGE_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# Downstream helpdesk / email dispatch endpoint called ONLY after HITL approval
REPLY_DISPATCH_URL=https://api.example.com/v1/tickets/reply
REPLY_DISPATCH_TOKEN=REPLACE_WITH_DISPATCH_API_TOKEN

# Immutable audit log endpoint (e.g., Supabase, Postgres webhook, or SIEM)
AUDIT_LOG_WEBHOOK_URL=https://api.example.com/v1/audit-log
AUDIT_LOG_TOKEN=REPLACE_WITH_AUDIT_LOG_TOKEN

# ------------------------------------------------------------------------------
# Blueprint 03: Weekly Revenue & Site Health Digest
# ------------------------------------------------------------------------------
# Stripe restricted read-only key (charges:read, invoices:read)
STRIPE_API_KEY=REPLACE_WITH_STRIPE_RESTRICTED_KEY

# Production site URL to audit each week
AUDIT_TARGET_URL=https://example.com

# Tizuvo Site Audit endpoint (hosted or self-hosted @tizuvo/site-audit-cli)
TIZUVO_AUDIT_ENDPOINT=https://tizuvo.com/api/audit

# Slack channel and email addresses for the Monday morning founder brief
SLACK_FOUNDERS_CHANNEL=#founders-digest
DIGEST_RECIPIENT_EMAIL=founders@example.com
DIGEST_SENDER_EMAIL=ops@example.com
